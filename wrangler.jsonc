{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dm-companion",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/", "/privacy", "/robots.txt", "/sitemap.xml", "/llms.txt"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dm-companion",
      "database_id": "bd90e086-a3e0-4931-b845-6f38e5e76539",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true },
  // Once a custom domain is attached, set it here so search engines see one address:
  // "vars": { "CANONICAL_HOST": "dmlantern.com" }
}
